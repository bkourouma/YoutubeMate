# URL du relais OAuth vidIQ personnel. Il reçoit les trois titres et renvoie
# leurs scores vidIQ exacts pour l’utilisateur Script Studio authentifié.
VIDIQ_SCORE_ENDPOINT=

# Chiffre les clés API enregistrées dans la base (AES-GCM). OBLIGATOIRE.
# Générer une valeur aléatoire forte, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Ne jamais la changer après avoir enregistré des clés : elles deviendraient illisibles.
SETTINGS_ENCRYPTION_KEY=

# Développement local uniquement : tient lieu d'en-tête d'identité ChatGPT.
# Doit rester ABSENTE en production.
DEV_USER_ID=

# Facultatif : cet utilisateur peut utiliser les clés serveur en secours.
ADMIN_USER_ID=

# Facultatif : restreint l'application à ces identifiants (séparés par des virgules).
ALLOWED_USER_IDS=

# Facultatif : clés de secours côté serveur, réservées à ADMIN_USER_ID.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
